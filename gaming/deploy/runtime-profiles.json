{
  "applications": [
    {
      "id": "xonotic", "executable": "/opt/Xonotic/xonotic-linux64-sdl",
      "working_directory": "/opt/Xonotic", "user": "ubuntu", "log_path": "/home/ubuntu/xonotic-demo.log",
      "arguments": ["-window", "+vid_width", "1280", "+vid_height", "720", "+vid_fullscreen", "0", "+cl_maxfps", "30"],
      "variants": { "match": ["+map", "stormkeep", "+bot_number", "2"] },
      "environment": { "DISPLAY": ":20", "XDG_RUNTIME_DIR": "/tmp/runtime-ubuntu", "PULSE_SERVER": "unix:/tmp/runtime-ubuntu/pulse/native" },
      "required_capabilities": ["xonotic-installed", "opengl", "streaming-desktop"]
    }
  ],
  "nodes": [
    { "id": "session-a", "docker_context": "desktop-linux", "compose_project": "digitalheat-gaming", "compose_service": "session-a", "browser_url": "http://localhost:18881", "hardware_profile_id": "intel-desktop" },
    { "id": "session-b", "docker_context": "desktop-linux", "compose_project": "digitalheat-gaming", "compose_service": "session-b", "browser_url": "http://localhost:18882", "hardware_profile_id": "software-desktop" },
    { "id": "session-c", "docker_context": "desktop-linux", "compose_project": "digitalheat-dozen", "compose_service": "session-c", "browser_url": "http://localhost:18883", "hardware_profile_id": "intel-xonotic" }
  ],
  "hardware_profiles": [
    { "id": "intel-desktop", "capabilities": ["opengl", "streaming-desktop"], "source": "Local Intel WSL OpenGL probe; requires compose intel-wsl.override.yaml. Not a heat/power measurement." },
    { "id": "software-desktop", "capabilities": ["streaming-desktop"], "source": "Software comparison desktop in compose.yaml. No accelerated game capability asserted." },
    { "id": "intel-xonotic", "capabilities": ["xonotic-installed", "opengl", "streaming-desktop"], "source": "User verified Xonotic on Node C; Test-Xonotic.ps1. Requires the Xonotic image, not the base Dozen image. Presentation settings are lab choices, not measured capacity." }
  ]
}
