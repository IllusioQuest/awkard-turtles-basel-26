{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DigitalHeat job descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "interruptible", "supportedControlLevels", "workUnit", "placementPolicy"],
  "properties": {
    "serviceMode": { "type": "string", "enum": ["batch", "always-on"], "default": "batch" },
    "id": { "type": "string", "minLength": 1 },
    "containerImage": { "type": ["string", "null"] },
    "command": { "type": ["array", "null"], "items": { "type": "string" }, "minItems": 1 },
    "interruptible": { "type": "boolean" },
    "supportedControlLevels": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["freeze", "throttle", "checkpoint"] }
    },
    "deadlineHours": { "$ref": "#/$defs/hoursOrMissing" },
    "workUnit": { "type": "string", "minLength": 1 },
    "runtimeSecondsPerWorkUnit": { "$ref": "#/$defs/secondsOrMissing" },
    "energyKwhPerWorkUnit": { "$ref": "#/$defs/energyOrMissing" },
    "progressFile": { "type": ["string", "null"] },
    "placementPolicy": { "$ref": "#/$defs/placementPolicy" }
  },
  "anyOf": [
    { "required": ["containerImage"], "properties": { "containerImage": { "type": "string", "minLength": 1 } } },
    { "required": ["command"], "properties": { "command": { "type": "array", "minItems": 1 } } }
  ],
  "allOf": [{
    "if": { "required": ["serviceMode"], "properties": { "serviceMode": { "const": "always-on" } } },
    "then": { "properties": {
      "interruptible": { "const": false },
      "supportedControlLevels": { "maxItems": 0 },
      "deadlineHours": { "type": "null" }
    }},
    "else": { "properties": {
      "interruptible": { "const": true },
      "supportedControlLevels": { "minItems": 1, "contains": { "const": "freeze" } }
    }}
  }],
  "$defs": {
    "placementPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "source"],
      "properties": {
        "mode": { "enum": ["anywhere", "origin-site", "country-allowlist"] },
        "source": { "type": "string", "minLength": 1, "not": { "pattern": "TODO\\(source\\)" } },
        "allowedCountryCodes": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z]{2}$" }
        }
      },
      "if": { "properties": { "mode": { "const": "country-allowlist" } } },
      "then": { "required": ["allowedCountryCodes"] },
      "else": { "not": { "required": ["allowedCountryCodes"] } }
    },
    "hoursOrMissing": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/quantityHours" }] },
    "secondsOrMissing": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/quantitySeconds" }] },
    "energyOrMissing": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/quantityEnergy" }] },
    "quantityHours": { "type": "object", "required": ["value", "unit", "source"], "properties": { "value": { "type": "number", "exclusiveMinimum": 0 }, "unit": { "const": "hours" }, "source": { "type": "string", "minLength": 1 } } },
    "quantitySeconds": { "type": "object", "required": ["value", "unit", "source"], "properties": { "value": { "type": "number", "minimum": 0 }, "unit": { "const": "s/work unit" }, "source": { "type": "string", "minLength": 1 } } },
    "quantityEnergy": { "type": "object", "required": ["value", "unit", "source"], "properties": { "value": { "type": "number", "minimum": 0 }, "unit": { "const": "kWh/work unit" }, "source": { "type": "string", "minLength": 1 } } }
  }
}
