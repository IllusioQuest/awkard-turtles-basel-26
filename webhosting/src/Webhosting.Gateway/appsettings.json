{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PassiveHealthPolicy": {
    "DetectionWindowSize": "00:00:05"
  },
  "Gateway": {
    "InstanceId": "gateway-local",
    "ListenAddress": "127.0.0.1",
    "Port": 18080,
    "BindRetrySeconds": 1,
    "Watchdog": {
      "Enabled": false,
      "IntervalSeconds": 1,
      "TimeoutSeconds": 1,
      "FailureThreshold": 3
    }
  },
  "ReverseProxy": {
    "Routes": {
      "sample": { "ClusterId": "sample", "Match": { "Path": "{**catch-all}" } }
    },
    "Clusters": {
      "sample": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:01", "Timeout": "00:00:01", "Policy": "ConsecutiveFailures", "Path": "/health" },
          "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:00:05" }
        },
        "Destinations": {
          "sample-a": { "Address": "http://127.0.0.1:18081/" },
          "sample-b": { "Address": "http://127.0.0.1:18082/" }
        }
      }
    }
  }
}
